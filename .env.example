GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Single input: one public article URL. Leave blank to auto-pick the next unused article (needs WP_SITE_URL).
ARTICLE_URL=https://example.com/your-article/
# Input 2 (optional, recommended): YouTube video, long or short. Adds variety to every post.
VIDEO_URL=
VIDEO_NOTES=
VIDEO_NOTES_FILE=
YOUTUBE_API_KEY=
INCLUDE_VIDEO_LINK=true
VIDEO_CHAR_LIMIT=6000
VIDEO_MAX_CHUNKS=5
DESTINATION_URL=
VIDEO_FILE=
MAKE_VIDEOS=true
USE_TTS=true
TTS_VOICE=en-US-AndrewNeural
BOARDS_CONFIG=brand/boards.json
WP_SITE_URL=
WP_CATEGORY_ID=
SEASON=
DISCLOSURE=
SOCIAL_OUTPUTS=true
ARTICLE_CHAR_LIMIT=9000
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
USE_AI_BACKGROUNDS=true
PINS_PER_ARTICLE=10
OUTPUT_DIR=output
DRAFTS_DIR=drafts
BRAND_CONFIG=brand/summer_section.json
